# book.config — minimal machine-readable settings for scaffold.sh

TITLE="The Year She Met Herself"
AUTHOR="Magnus N."
GENRE="adult literary / upmarket book-club fiction"

# Production
CHAPTER_COUNT=13         # number of long chapters
WORD_FLOOR=12000         # hard minimum words per chapter
TOTAL_TARGET=175000      # whole-book target (~150-200k)
SCENE_MARK="◆"           # scene divider symbol used inside chapters

# Drafting
COMPRESS_DRAFT=true      # draft with compress-fiction codec (~20x fewer output tokens)

# Git
BRANCH="claude/relaxed-mayer-TIm1Z"

# Optional: short slug used for chapter filenames
SLUG="the-year-she-met-herself"
